<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-API 26 fallback: solid circle + white glyph (tints are ignored on shortcuts). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item>
		<shape android:shape="oval">
			<solid android:color="@color/qaas_shortcut_icon_bg" />
			<size
				android:width="48dp"
				android:height="48dp" />
		</shape>
	</item>
	<item
		android:drawable="@drawable/ic_shortcut_love_glyph"
		android:left="12dp"
		android:top="12dp"
		android:right="12dp"
		android:bottom="12dp" />
</layer-list>
